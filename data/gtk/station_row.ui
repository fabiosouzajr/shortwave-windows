<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="SwStationRow" parent="AdwBin">
    <property name="width_request">340</property>
    <property name="overflow">hidden</property>
    <child>
      <object class="GtkBox">
        <child>
          <object class="SwStationCover" id="station_cover">
            <property name="size">88</property>
            <binding name="station">
              <lookup name="station">SwStationRow</lookup>
            </binding>
          </object>
        </child>
        <child>
          <object class="GtkSeparator">
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <property name="margin_end">12</property>
            <property name="margin_start">12</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="valign">center</property>
                <property name="spacing">3</property>
                <child>
                  <object class="GtkLabel" id="station_label">
                    <property name="hexpand">True</property>
                    <property name="label">label</property>
                    <property name="ellipsize">end</property>
                    <property name="max_width_chars">0</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="station-name" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="subtitle_box">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage" id="flag_image">
                        <property name="pixel_size">16</property>
                        <property name="valign">center</property>
                        <property name="visible">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="subtitle_label">
                        <property name="hexpand">True</property>
                        <property name="label">label</property>
                        <property name="ellipsize">end</property>
                        <property name="max_width_chars">0</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dimmed" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="quality_box">
                    <property name="spacing">6</property>
                    <style>
                      <class name="station-quality" />
                    </style>
                    <child>
                      <object class="GtkImage" id="codec_image">
                        <property name="icon_name">codec-lossy-symbolic</property>
                        <property name="pixel_size">12</property>
                        <style>
                          <class name="dimmed" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="codec_label">
                        <property name="label">label</property>
                        <style>
                          <class name="codec" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="quality_separator">
                        <property name="label">│</property>
                        <style>
                          <class name="separator-text" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="bars_box">
                        <property name="spacing">2</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkBox">
                            <property name="valign">end</property>
                            <property name="height_request">4</property>
                            <style>
                              <class name="bar" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="valign">end</property>
                            <property name="height_request">7</property>
                            <style>
                              <class name="bar" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="valign">end</property>
                            <property name="height_request">9</property>
                            <style>
                              <class name="bar" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="valign">end</property>
                            <property name="height_request">11</property>
                            <style>
                              <class name="bar" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="bitrate_label">
                        <property name="label">label</property>
                        <property name="use_markup">True</property>
                        <style>
                          <class name="bitrate" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="local_image">
                <property name="icon_name">cloud-disabled-symbolic</property>
                <property name="visible">False</property>
                <property name="tooltip_text" translatable="yes">Local Station</property>
                <binding name="visible">
                  <lookup name="is-local" type="SwStation">
                    <lookup name="station">SwStationRow</lookup>
                  </lookup>
                </binding>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="orphaned_image">
                <property name="icon_name">dialog-error-symbolic</property>
                <property name="visible">False</property>
                <property name="tooltip_text" translatable="yes">Orphaned Station</property>
                <binding name="visible">
                  <lookup name="is-orphaned" type="SwStation">
                    <lookup name="station">SwStationRow</lookup>
                  </lookup>
                </binding>
                <style>
                  <class name="error" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="play_button">
                <property name="width_request">36</property>
                <property name="height_request">36</property>
                <property name="valign">center</property>
                <property name="icon_name">media-playback-start-symbolic</property>
                <property name="tooltip_text" translatable="yes">Play</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="card" />
      <class name="activatable" />
    </style>
  </template>
</interface>